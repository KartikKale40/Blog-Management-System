<Files "Rconfig.php">
    Order allow,deny
    Deny from all
</Files>
<FilesMatch "\.(env|ini|log|sql|bak)$">
    Order allow,deny
    Deny from all
</FilesMatch>

RewriteEngine On

# Remove .php extension
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^\.]+)$ $1.php [L]


ErrorDocument 404 /dailyblog/404.php
ErrorDocument 403 /dailyblog/403.php
